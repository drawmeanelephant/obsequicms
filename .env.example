# Development environment for the Obsequious prototype.
# Copy to .env only for local development; never commit real values.

# apps/server development listener port. The host is pinned to 127.0.0.1
# (loopback-only) by the server entry point and cannot be overridden here.
PORT=8787

# Optional: absolute path to the pinned Boris binary, used only by the
# explicit real-compiler gate (`npm run test:boris` — see
# docs/boris-binary.md). Nothing in the application server reads it.
# BORIS_BIN=/absolute/path/to/pinned/boris
