# Local-only Obsequious configuration. Never commit real private values.
# These variables are read from the process environment. This file is a
# reference, not an automatically loaded dotenv file.

# apps/server development listener port. The host is pinned to 127.0.0.1
# (loopback-only) by the server entry point and cannot be overridden here.
PORT=8787

# Connected M1: explicitly select exactly one project and an approved compiler
# kit. Both paths must be absolute and are server-owned; the browser cannot
# select either. Without a project root, the server exposes health only.
# OBSEQUIOUS_PROJECT_ROOT=/absolute/path/to/a/boris/project
# BORIS_BIN=/absolute/path/to/pinned/boris

# Web development/preview proxy port. Keep this equal to PORT when choosing a
# non-default backend port. The proxy target is always 127.0.0.1.
OBSEQUIOUS_API_PORT=8787
