    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@obsequious/contracts": "0.0.0",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15"
  }
}
